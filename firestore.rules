rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // LAYER 15: NH POS SHOP v18.0.0 — ZERO-TRUST FIRESTORE SECURITY FORTRESS
    // =========================================================================

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9._@-]+$');
    }

    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'helpgoodforyouofficial@gmail.com' ||
          request.auth.token.email == 'aliimtiaz1126@gmail.com'
        );
    }

    function hasNoUnauthorizedPrivilegeEscalation(data) {
      return isSuperAdmin() || (
        (!('role' in data) || data.role != 'super_admin')
        && (!('isSuperAdmin' in data) || data.isSuperAdmin != true)
      );
    }

    function isValidPayload() {
      return request.resource.data is map
        && request.resource.data.keys().size() > 0
        && request.resource.data.keys().size() <= 120
        && hasNoUnauthorizedPrivilegeEscalation(request.resource.data);
    }

    function isValidShopData(data) {
      return isValidPayload()
        && (!('shop_name' in data) || data.shop_name == null || (data.shop_name is string && data.shop_name.size() <= 120))
        && (!('owner_email' in data) || data.owner_email == null || (data.owner_email is string && data.owner_email.size() <= 120))
        && (!('owner_name' in data) || data.owner_name == null || (data.owner_name is string && data.owner_name.size() <= 120))
        && (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 32))
        && (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 240));
    }

    function isShopOwnerImmutable() {
      return isSuperAdmin() || (
        (!('owner_email' in resource.data) || !('owner_email' in request.resource.data) || request.resource.data.owner_email == resource.data.owner_email)
        && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id)
      );
    }

    function isRegistryImmutable() {
      return isSuperAdmin() || (
        (!('shop_id' in resource.data) || !('shop_id' in request.resource.data) || request.resource.data.shop_id == resource.data.shop_id)
        && (!('email' in resource.data) || !('email' in request.resource.data) || request.resource.data.email == resource.data.email)
      );
    }

    function isValidStaffDirectoryData(data) {
      return isValidPayload()
        && ('shop_id' in data && data.shop_id is string && isValidId(data.shop_id))
        && (!('username' in data) || (data.username is string && data.username.size() >= 2 && data.username.size() <= 64))
        && (!('role' in data) || data.role in ['manager', 'cashier', 'salesman', 'staff', 'admin']);
    }

    function isAllowedShopSubcollection(sub) {
      return sub in [
        'daily_transactions',
        'back_cash_transactions',
        'wholesaler_bills',
        'customer_bills',
        'easyload_records',
        'bottle_items',
        'stock_transactions',
        'staff_accounts',
        'edit_history',
        'deleted_history',
        'auth_audit_logs'
      ];
    }

    function parentShopExists(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId));
    }

    // 1. Platform & System Settings: Readable by shops; Writable/Listable ONLY by verified Super Admin
    match /platform_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidId(settingId) && isValidPayload();
      allow delete: if isSuperAdmin() && isValidId(settingId);
    }

    match /system_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidId(settingId) && isValidPayload();
      allow delete: if isSuperAdmin() && isValidId(settingId);
    }

    // 2. Staff Directory: Single-doc lookup ONLY (Blocks bulk staff scraping & super_admin escalation)
    match /staff_directory/{username} {
      allow get: if isValidId(username);
      allow list: if isSuperAdmin();
      allow create: if isValidId(username) && isValidStaffDirectoryData(request.resource.data);
      allow update: if isValidId(username)
        && isValidStaffDirectoryData(request.resource.data)
        && (isSuperAdmin() || request.resource.data.shop_id == resource.data.shop_id);
      allow delete: if isValidId(username);
    }

    // 3. Account Registry: Blocks unauthenticated bulk scraping, ownership hijacking & non-admin deletion
    match /account_registry/{emailKey} {
      allow get: if isValidId(emailKey);
      allow list: if isSuperAdmin() || (request.auth != null && request.query.limit <= 25);
      allow create: if isValidId(emailKey) && isValidPayload();
      allow update: if isValidId(emailKey) && isValidPayload() && isRegistryImmutable();
      allow delete: if isSuperAdmin() && isValidId(emailKey);
    }

    // 4. User Profiles: Single-doc lookup only; blocks bulk scraping, privilege escalation & deletion
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(userId) && isValidPayload();
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // 5. Device Trust & Revocations: Single-doc check & bind only (Zero bulk listing)
    match /device_trust/{trustId} {
      allow get: if isValidId(trustId);
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(trustId) && isValidPayload() && request.resource.data.keys().size() <= 20;
      allow delete: if isSuperAdmin() && isValidId(trustId);
    }

    match /device_revocations/{revId} {
      allow get: if isValidId(revId);
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(revId) && isValidPayload() && request.resource.data.keys().size() <= 15;
      allow delete: if isSuperAdmin() && isValidId(revId);
    }

    match /auth_audit_logs/{logId} {
      allow get, list: if isSuperAdmin();
      allow create: if isValidId(logId) && isValidPayload() && request.resource.data.keys().size() <= 15;
      allow update, delete: if isSuperAdmin();
    }

    // 6. Multi-Tenant Shops & Strictly Allowlisted Subcollections (Master Gate Enforced)
    match /shops/{shopId} {
      allow get: if isValidId(shopId);
      allow list: if isSuperAdmin() || (request.auth != null && request.query.limit <= 25);
      allow create: if isValidId(shopId) && isValidShopData(request.resource.data);
      allow update: if isValidId(shopId) && isValidShopData(request.resource.data) && isShopOwnerImmutable();
      allow delete: if isSuperAdmin() && isValidId(shopId);

      match /{subcollection}/{docId} {
        allow get: if isValidId(shopId)
          && isValidId(docId)
          && isAllowedShopSubcollection(subcollection);
        allow list: if isValidId(shopId)
          && isAllowedShopSubcollection(subcollection);
        allow create, update: if isValidId(shopId)
          && isValidId(docId)
          && isValidPayload()
          && isAllowedShopSubcollection(subcollection)
          && parentShopExists(shopId);
        allow delete: if isValidId(shopId)
          && isValidId(docId)
          && isAllowedShopSubcollection(subcollection)
          && parentShopExists(shopId);
      }
    }

    // 7. Default-Deny Catch-All: Completely block all unmatched paths & rogue collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
