# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SERVER-SIDE NETLIFY / CLOUD FUNCTIONS SECRETS (Set in Netlify Dashboard -> Environment Variables)
# Never expose these with a VITE_ prefix or commit real values to Git!
AUTH_TOKEN_SECRET=
SUPER_ADMIN_SECRET_KEY=
SUPER_ADMIN_EMAILS=
FIREBASE_PROJECT_ID=
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
EMAIL_FROM=
ALLOWED_ORIGINS=

