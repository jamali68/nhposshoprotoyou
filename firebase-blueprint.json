{
  "entities": {
    "ShopProfile": {
      "title": "ShopProfile",
      "description": "Tenant shop profile and hashed authentication credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9._@-]+$" },
        "shop_name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "owner_name": { "type": "string", "maxLength": 120 },
        "owner_email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 240 },
        "passwordHash": { "type": "string", "maxLength": 256 },
        "passwordSalt": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "shop_name", "owner_email"]
    },
    "AccountRegistry": {
      "title": "AccountRegistry",
      "description": "Email-indexed tenant lookup registry",
      "type": "object",
      "properties": {
        "shop_id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "shop_name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "super_admin"] }
      },
      "required": ["shop_id", "email"]
    },
    "StaffDirectoryEntry": {
      "title": "StaffDirectoryEntry",
      "description": "Staff username lookup record bound to a single shop",
      "type": "object",
      "properties": {
        "username": { "type": "string", "minLength": 2, "maxLength": 64 },
        "shop_id": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["manager", "cashier", "salesman", "staff"] },
        "is_active": { "type": "boolean" }
      },
      "required": ["username", "shop_id", "role"]
    },
    "ShopLedgerRecord": {
      "title": "ShopLedgerRecord",
      "description": "Generic POS transaction, khata bill, stock, or audit record scoped inside a tenant shop",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "created_at": { "type": "string", "maxLength": 64 }
      }
    },
    "DeviceTrustRecord": {
      "title": "DeviceTrustRecord",
      "description": "Physical device authorization and revocation metadata",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["trusted", "revoked"] }
      },
      "required": ["email", "deviceId", "status"]
    },
    "PlatformSetting": {
      "title": "PlatformSetting",
      "description": "Super Admin controlled global settings such as module_control and demo_template",
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 120 },
        "baseDate": { "type": "string", "maxLength": 32 },
        "resetIntervalMinutes": { "type": "number" },
        "autoShiftDatesToToday": { "type": "boolean" },
        "hasCustomTemplate": { "type": "boolean" },
        "payloadJson": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/platform_settings/{settingId}": {
      "schema": "PlatformSetting",
      "description": "Global platform configuration and Super Admin published Demo Store master template"
    },
    "/shops/{shopId}": {
      "schema": "ShopProfile",
      "description": "Multi-tenant shop root documents"
    },
    "/shops/{shopId}/{subcollection}/{docId}": {
      "schema": "ShopLedgerRecord",
      "description": "Allowlisted tenant subcollections guarded by parent shop existence"
    },
    "/account_registry/{emailKey}": {
      "schema": "AccountRegistry",
      "description": "Email-keyed shop registration index"
    },
    "/staff_directory/{username}": {
      "schema": "StaffDirectoryEntry",
      "description": "Single-document staff login directory"
    },
    "/device_trust/{trustId}": {
      "schema": "DeviceTrustRecord",
      "description": "Authorized device trust records"
    },
    "/device_revocations/{revId}": {
      "schema": "DeviceTrustRecord",
      "description": "Revoked device records"
    }
  }
}
